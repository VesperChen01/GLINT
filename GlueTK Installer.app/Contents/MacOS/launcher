#!/bin/bash
# GlueTK Installer Launcher (Tk GUI via conda python)

# macOS app bundle 启动时环境变量不完整，需要手动查找 conda
CONDA_BASE=""
CONDA_PATHS=(
  "$HOME/miniconda3"
  "$HOME/anaconda3"
  "$HOME/miniforge3"
  "$HOME/mambaforge"
  "/opt/miniconda3"
  "/opt/anaconda3"
  "/opt/homebrew/Caskroom/miniconda/base"
  "/usr/local/Caskroom/miniconda/base"
)

# 先尝试 source conda profile (如果存在)
for base in "${CONDA_PATHS[@]}"; do
  if [ -f "${base}/etc/profile.d/conda.sh" ]; then
    source "${base}/etc/profile.d/conda.sh" 2>/dev/null
    CONDA_BASE="$base"
    break
  fi
done

# 如果 source 成功，验证 conda 可用
if [ -n "$CONDA_BASE" ] && command -v conda &>/dev/null; then
  : # conda found
else
  # 直接检查 conda 可执行文件
  CONDA_BASE=""
  for base in "${CONDA_PATHS[@]}"; do
    if [ -x "${base}/bin/conda" ]; then
      CONDA_BASE="$base"
      export PATH="${CONDA_BASE}/bin:$PATH"
      break
    fi
  done
fi

if [ -z "$CONDA_BASE" ]; then
  osascript -e 'display alert "Conda Not Found" message "Please install Miniconda first.\n\nDownload: https://docs.conda.io/en/latest/miniconda.html\n\nThen re-run GlueTK Installer."'
  open "https://docs.conda.io/en/latest/miniconda.html"
  exit 1
fi

# 使用 conda base 环境的 Python (有 Tk 支持)
PYTHON="${CONDA_BASE}/bin/python"
if [ ! -x "$PYTHON" ]; then
  osascript -e 'display alert "Python Not Found" message "Conda base Python not found at: '"$PYTHON"'"'
  exit 1
fi

# 获取资源目录
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
RESOURCES_DIR="$(dirname "$DIR")/Resources"
INSTALLER_SCRIPT="${RESOURCES_DIR}/GlueTK_Installer.py"

# 确保 Tk 可以正常渲染
export DISPLAY=:0
"$PYTHON" "$INSTALLER_SCRIPT"
